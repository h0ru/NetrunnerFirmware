# Target: ESP32-S3 (LilyGo T-Embed CC1101) — the only board this port supports.
CONFIG_IDF_TARGET="esp32s3"

# Bluetooth Low Energy for Bad USB BLE HID
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=8
CONFIG_BT_NIMBLE_MAX_CCCDS=8
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=4
# Use ESP-IDF's normal controller capacity. The previous one-activity cap
# prevented even basic advertising and left no headroom for coexistence tests.
CONFIG_BT_CTRL_BLE_MAX_ACT=6
# Legacy advertising/scanning is used throughout this firmware. Keep the
# unused BLE 5 extended scan/periodic-sync machinery out of the image and heap.
# CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT is not set

# Keep the 2.4 GHz arbiter enabled so WiFi and BLE can stay active together.
CONFIG_ESP_COEX_ENABLED=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# FreeRTOS configuration for Furi compatibility
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_SUPPORT_STATIC_ALLOCATION=y
CONFIG_FREERTOS_TASK_NOTIFICATION_ARRAY_ENTRIES=3
# Slot 0 is reserved by ESP-IDF pthread; Furi uses slot 1. Keep one spare so
# thread cleanup can never overwrite the pthread deletion callback.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# Heap
CONFIG_HEAP_TRACING_OFF=y

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# Task watchdog
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# System
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# FAT filesystem: enable Long File Names (stored on heap)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
# Required so FatFs compiles with exFAT enabled (tools/patch_fatfs_exfat.py):
# the exFAT dir reader references FF_USE_LABEL in C. Also makes the
# f_setlabel("Netrunner SD") call in the SD formatter effective.
CONFIG_FATFS_USE_LABEL=y

# WiFi HTTPS downloads: allow without server-certificate verification
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
# mbedTLS-Allokationen ins PSRAM (interner DRAM reicht mit WiFi nicht für den
# TLS-Handshake → sonst -0x7F00/-0x2880). Langsamer als intern, aber stabil;
# DYNAMIC_BUFFER + SPIRAM_TRY_ALLOCATE_WIFI_LWIP crashen den WiFi-Treiber.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# ============================================================================
# ESP32-S3 / T-Embed settings (formerly sdkconfig.defaults.esp32s3)
# ============================================================================
# ESP32-S3 / LilyGo T-Embed CC1101 hardware settings.

# Flash: T-Embed CC1101 has 16MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Single-app partition table (no self-update / dual-boot). nvs + phy_init +
# factory; /int is an SD-card shadow dir and bundled assets install gracefully
# skips when no asset partition exists, so no spiffs/coredump slot is required.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_singleapp_large.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_singleapp_large.csv"

# ESP32-S3 is dual-core Xtensa — keep unicore for Furi compatibility
CONFIG_FREERTOS_UNICORE=y

# BLE: Use legacy 4.2 advertising (5.0 extended adv not seen by all phones)
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
# CONFIG_BT_BLE_50_FEATURES_SUPPORTED is not set
# Allocate NimBLE host objects and buffers from PSRAM. The controller keeps its
# DMA-critical memory internal, while the host no longer competes with WiFi and
# RAM-heavy apps for scarce internal DRAM.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# Don't cache PHY calibration in NVS. With BT buffers in PSRAM (above), the NVS
# flash-write that phy_init does on boot ("Saving new calibration data") briefly
# stalls the shared flash/PSRAM MSPI cache; a BLE controller ISR touching a
# PSRAM-resident buffer in that window deadlocks in wait-for-intr -> the 300 ms
# interrupt watchdog fires (TG1WDT_SYS_RST) -> intermittent boot loop. Disabling
# the NVS store removes that flash-write entirely; the PHY is (re)calibrated on
# every boot instead (a few ms, no RF quality loss).
# CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE is not set

# Same class of bug as the PHY-cal store above: the WiFi NVS store issues
# flash-writes at runtime that stall the shared flash/PSRAM MSPI cache. The SMB
# browser runs long libsmb2 crypto (NTLMSSP) out of flash/PSRAM; a WiFi NVS
# flash-write in that window panics it ("Cache disabled but cached memory region
# accessed", crash in NTOWFv2). Disabling the WiFi NVS store removes the last
# runtime flash-writer (app settings already go to SD via saved_struct). WiFi
# still works; it just re-reads config each boot instead of caching it in NVS.
# CONFIG_ESP_WIFI_NVS_ENABLED is not set

# PSRAM: T-Embed CC1101 has 8MB PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Allow malloc to fall back to PSRAM when internal RAM is exhausted
CONFIG_SPIRAM_USE_MALLOC=y
# Allocations <= 1024 bytes stay in internal RAM (DMA, TCB, stack); larger ones
# fall to PSRAM. Lowered from 4096: Sub-GHz alloc'd ~25KB of small (<4096B) chunks
# into internal RAM, dropping it to ~1.5KB free and starving the BLE controller's
# TX buffers. With 1024 those chunks go to the abundant (5MB) PSRAM instead.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
# Reserve 64KB internal RAM for DMA/stacks/TCBs
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Allow task stacks in PSRAM (needed for large apps)
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# Enable code execution from PSRAM (needed for FAP dynamic loading)
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
# Allow .bss to live in PSRAM. Auto-maps lwip/net80211/pp/bt BSS to SPIRAM,
# and exposes the `extram_bss` linker scheme for our own mappings (see main/main.lf).
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# NFC needs 3DES (felica, mf_ultralight)
CONFIG_MBEDTLS_DES_C=y

# WPA3-SAE authentication has proved reliable with the S3 hardware-AES backend
# when wlan_hal reserves its two transient DMA bounce buffers before GUI views
# fragment internal RAM.
CONFIG_MBEDTLS_HARDWARE_AES=y

# TinyUSB (USB HID for BadUSB + CDC for RPC + MSC for SD-Card USB-Stick)
# Composite descriptor lives in components/furi_hal/furi_hal_usb_tinyusb_composite.c
CONFIG_TINYUSB_HID_COUNT=2
CONFIG_TINYUSB_HID_BUFSIZE=64
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_MSC_ENABLED=y
# 4 KiB MSC FIFO → 8 sectors/transfer. Higher = faster, but pulls from internal RAM.
CONFIG_TINYUSB_MSC_BUFSIZE=4096
CONFIG_TINYUSB_MIDI_ENABLED=n
CONFIG_TINYUSB_NCM_ENABLED=n
CONFIG_TINYUSB_DEBUG_LEVEL=1

# esp_http_server: increase header / URI limits for Evil Portal so smartphones
# with large cookie sets don't trip the 431 "Request Header Fields Too Large" error.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=2048
CONFIG_HTTPD_WS_SUPPORT=y

# Live-Credential-Dissektor parst im tcpip_thread → etwas mehr Stack-Reserve.
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096

# lwIP: bump max sockets from default 10 → 16 so evil_portal httpd can use
# max_open_sockets=13 (10 was leaving only 7 for the HTTP server, which Windows
# clients exhaust instantly with background traffic — Steam, Discord, NCSI,
# WPAD all phone home in parallel and cause ERR_CONNECTION_RESET in browser
# captive-portal probes).
CONFIG_LWIP_MAX_SOCKETS=16

# lwIP: enable IP forwarding + IPv4 NAPT so esp_netif_napt_enable() actually
# routes packets between the rogue AP and the upstream STA after Evil Portal
# Bridge activates. Without these flags napt_enable() returns OK but no packets
# are forwarded — clients on the AP get DHCP+DNS but cannot reach the internet.
# L2_TO_L3_COPY is required by NAPT for the inter-interface packet copy.
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_L2_TO_L3_COPY=y

# Hardware escape hatch: hold the side/Back key (IO06, active low) for 3 s while
# the board starts and the BOOTLOADER erases otadata, so the board comes up on
# `factory` -- this firmware. It runs before any app code, so it recovers a board
# whose ota_0 firmware hangs, crashes, or has no way back of its own.
#
# This was configured and hardware-verified on 2026-08-17 and then LOST -- it was
# never committed, and a later revert took it out of the tree. The symptom is
# silent: the key does nothing and the board just boots whatever otadata says.
#
# IO00 cannot be used: it is the ESP32-S3 download-mode strapping pin, so holding
# it at reset drops the chip into the serial bootloader. IO06 is not a strapping
# pin (those are 0/3/45/46).
#
# BOOTLOADER_DATA_FACTORY_RESET defaults to "nvs" and is a STRING, not a bool --
# left alone it would wipe settings and BT bonds on every escape-hatch press. Only
# otadata should be cleared, so it is forced empty.
CONFIG_BOOTLOADER_FACTORY_RESET=y
CONFIG_BOOTLOADER_NUM_PIN_FACTORY_RESET=6
CONFIG_BOOTLOADER_FACTORY_RESET_PIN_LOW=y
CONFIG_BOOTLOADER_OTA_DATA_ERASE=y
CONFIG_BOOTLOADER_DATA_FACTORY_RESET=""
CONFIG_BOOTLOADER_HOLD_TIME_GPIO=3

# App rollback (OTA trial boots) is disabled: single-app layout has no OTA slot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n

# --- WiFi internal-DRAM footprint (Hotspot Arcade / SoftAP) ---
# esp_wifi_init needs CONTIGUOUS INTERNAL DRAM for its esf_buf pool, which
# PSRAM cannot back. With the stock values (STATIC_RX=10, AMPDU on) there was
# only ~13 KB free and a ~7 KB largest block by the time an app asked for the
# AP, and init failed with ESP_ERR_NO_MEM. Each static RX buffer is ~1.6 KB of
# internal DRAM, and the AMPDU block-ack windows cost more on top.
# A local SoftAP serving one small web UI does not need AMPDU or deep queues.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
# Pushes what CAN live in PSRAM there. Not sufficient alone (measured), but it
# stacks with the reductions above.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# esf_buf_setup_static() allocates ONE CONTIGUOUS pool, and static TX
# buffers dominate it: 16 x ~1.6 KB = ~25 KB. Measured on hardware, the
# AP starts when the largest free internal block is ~28 KB and fails with
# "alloc eb fail(1)" at ~20 KB -- with 60 KB still free overall. So this
# is a FRAGMENTATION limit, not a total-memory one, and the fix is to
# shrink what must be contiguous.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
# lwIP sys_thread_sem_get() stores a per-thread semaphore via pthread TLS,
# and Furi threads use a TLS pointer too. With only 1 slot they collide and
# pthread_getspecific() NULL-derefs the moment a non-httpd task pushes a
# WebSocket frame (Hotspot Arcade game change / gameplay).
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=3
